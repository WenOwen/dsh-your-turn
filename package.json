{
  "name": "@wu5/dsh-your-turn",
  "version": "0.1.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Turn-handoff reminder for DeepSeek Harness: an interactive centred popup plus a synthesized chime when the agent hands the turn back to you. · DSH 回合交接提醒：轮到你了——可交互居中弹窗 + 免素材提示音。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts",
    "lib/client.js",
    "cordis.patch.yml",
    "assets",
    "README.md",
    "README.zh.md",
    "README.en.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "notification",
    "notify",
    "sound",
    "chime",
    "popup",
    "modal",
    "turn-complete",
    "session-complete",
    "agent",
    "reminder",
    "web-audio",
    "synthesized",
    "提醒",
    "提示音",
    "弹窗",
    "轮到你了"
  ],
  "homepage": "https://github.com/WenOwen/dsh-your-turn#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/WenOwen/dsh-your-turn.git"
  },
  "bugs": {
    "url": "https://github.com/WenOwen/dsh-your-turn/issues"
  },
  "author": {
    "name": "WenOwen",
    "url": "https://github.com/WenOwen"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "node \"C:/Users/Administrator/.agents/skills/build-deepseek-harness-plugin/scripts/check_plugin.mjs\" .",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@types/node": "^22.10.0",
    "@types/react": "~18.3.1",
    "jsdom": "^30.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
